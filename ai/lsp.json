{
  "typescript": {
    "command": "bunx",
    "args": [
      "--bun",
      "typescript-language-server",
      "--stdio"
    ],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".jsx": "javascriptreact"
    },
    "startupTimeout": 30000
  },
  "python": {
    "command": "bunx",
    "args": [
      "--bun",
      "--package",
      "pyright",
      "pyright-langserver",
      "--stdio"
    ],
    "extensionToLanguage": {
      ".py": "python"
    }
  },
  "rust": {
    "command": "rust-analyzer",
    "args": [],
    "extensionToLanguage": {
      ".rs": "rust"
    }
  }
}

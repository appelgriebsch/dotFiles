{
  "chat.agent.enabled": true,
  "crates.compatibleDecorator": " ${version}",
  "crates.errorDecorator": "",
  "crates.incompatibleDecorator": " ${version}",
  "dbcode.pagination": true,
  "dbcode.history.enabled": true,
  "dbcode.useLanguageServer": true,
  "dbcode.resultLocation": "below",
  "debug.toolBarLocation": "commandCenter",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorStyle": "line",
  "editor.fontFamily": "'FiraCode Nerd Font', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modifications",
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": true,
  "editor.renderWhitespace": "boundary",
  "editor.tabCompletion": "on",
  "editor.tabSize": 4,
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{​​​​​​}​​​​​​`?-",
  "editor.wordWrap": "off",
  "errorLens.messageBackgroundMode": "none",
  "explorer.confirmDelete": false,
  "extensions.ignoreRecommendations": true,
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "githubPullRequests.experimental.useQuickChat": true,
  "js/ts.inlayHints.enumMemberValues.enabled": true,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.inlayHints.parameterNames.suppressWhenArgumentMatchesName": false,
  "js/ts.inlayHints.parameterTypes.enabled": true,
  "js/ts.inlayHints.propertyDeclarationTypes.enabled": true,
  "js/ts.inlayHints.variableTypes.enabled": true,
  "js/ts.implicitProjectConfig.strictNullChecks": true,
  "julia.enableTelemetry": false,
  "julia.symbolCacheDownload": true,
  "notebook.lineNumbers": "on",
  "redhat.telemetry.enabled": false,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.testExplorer": true,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.enableImages": true,
  "terminal.integrated.fontLigatures.enabled": true,
  "update.mode": "start",
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.cursorStylePerMode.insert": "line",
  "vim.highlightedyank.enable": true,
  "vim.useSystemClipboard": true,
  "window.dialogStyle": "custom",
  "window.menuBarVisibility": "toggle",
  "window.restoreWindows": "none",
  "window.autoDetectColorScheme": true,
  "window.commandCenter": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.startupEditor": "welcomePage",
  "workbench.iconTheme": "ayu",
  "workbench.editor.showTabs": "single",
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {},
  "editor.formatOnType": true,
  "notebook.defaultFormatter": "EditorConfig.EditorConfig",
  "notebook.formatOnCellExecution": true,
  "notebook.formatOnSave.enabled": true,
  "githubPullRequests.pullBranch": "never",
  "git.ignoreRebaseWarning": true,
  "workbench.colorTheme": "Ayu Mirage",
  "git.blame.editorDecoration.enabled": true,
  "diffEditor.experimental.showMoves": true,
  "githubPullRequests.pullRequestDescription": "Copilot",
  "githubPullRequests.fileListLayout": "tree",
  "workbench.preferredDarkColorTheme": "Ayu Mirage",
  "workbench.preferredLightColorTheme": "Ayu Light",
  "window.systemColorTheme": "auto",
  "githubPullRequests.createOnPublishBranch": "never",
  "inlineChat.enableV2": true,
  "inlineChat.notebookAgent": true,
  "chat.agent.sandbox.enabled": "on",
  "inlineChat.askInChat": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "dbcode.ai.inlineCompletion": false,
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.gpuAcceleration": "off",
  "workbench.experimental.modernUI": true,
  "chat.agentHost.enabled": true,
  "rust-analyzer.server.path": "~/.cargo/bin/rust-analyzer",
  "chat.viewSessions.orientation": "stacked",
  "grok.summarizeRepliesAloud": false,
  "local-sync.removeExtensions": true
}